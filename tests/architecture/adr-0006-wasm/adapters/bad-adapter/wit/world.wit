// Intentional POISON component for Gate 2 (admission compatibility).
//
// This is a structurally valid WebAssembly component, but its world is
// *incompatible* with the `adapter` world every valid adapter must satisfy:
// it neither imports the `http` or `runtime` interfaces, nor exports the
// `adapter-api` interface (no `reconcile`). It exists solely to prove the
// host rejects such a component at admission, before any provider resolution,
// reconciliation invocation, or target mutation.

package permissionsync:bad-adapter@0.1.0;

interface salute {
    greet: func() -> string;
}

world bad {
    export salute;
}
